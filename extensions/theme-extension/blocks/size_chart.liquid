{% comment %} Size Chart – app block for product templates {% endcomment %}

{%- if product -%}
  {% render 'size-chart',
     product: product,
     uid: block.id,
     mode: 'block',
     button_text: block.settings.button_text,
     display_mode: block.settings.display_mode,
     default_unit: block.settings.default_unit,
     override_color: block.settings.override_color,
     primary_color: block.settings.primary_color,
     border_radius: block.settings.border_radius %}
{%- endif -%}

{% schema %}
{
  "name": "Size Chart",
  "target": "content",
  "stylesheet": "size-chart.css",
  "javascript": "size-chart.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a Size guide button for this product. The chart comes from the app's Assignment rules or a product override. Leave a field blank to use the app Settings value."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "info": "Leave blank to use Settings → Button text."
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "", "label": "Use app settings" },
        { "value": "modal", "label": "Modal" },
        { "value": "drawer", "label": "Side drawer" },
        { "value": "inline", "label": "Inline" },
        { "value": "accordion", "label": "Accordion" },
        { "value": "link", "label": "Text link next to the variant picker" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "default_unit",
      "label": "Default unit",
      "options": [
        { "value": "", "label": "Use app settings" },
        { "value": "cm", "label": "Centimetres (cm)" },
        { "value": "in", "label": "Inches (in)" }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "override_color",
      "label": "Override button colour",
      "default": false
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Button colour",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "border_radius",
      "label": "Corner radius",
      "info": "Leave blank to use the app Settings value. Example: 8px"
    }
  ]
}
{% endschema %}
