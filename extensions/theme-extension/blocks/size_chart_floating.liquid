{% comment %} Size Chart Float – app embed with a floating button on product pages {% endcomment %}

{%- if request.page_type == 'product' and product -%}
  {% render 'size-chart',
     product: product,
     uid: block.id,
     mode: 'float',
     button_text: block.settings.button_text,
     position: block.settings.position,
     override_color: block.settings.override_color,
     primary_color: block.settings.primary_color %}
{%- endif -%}

{% schema %}
{
  "name": "Size Chart Float",
  "target": "body",
  "stylesheet": "size-chart.css",
  "javascript": "size-chart.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a floating Size guide button to product pages. Use either this embed or the Size Chart app block — not both — to avoid two buttons."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "info": "Leave blank to use Settings → Button text."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "", "label": "Use app settings" },
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "override_color",
      "label": "Override button colour",
      "default": false
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Button colour",
      "default": "#111111"
    }
  ]
}
{% endschema %}
